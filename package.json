{
  "name": "player-portal-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "check:ags": "node --env-file=.env --import tsx scripts/check-ags.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@accelbyte/sdk": "4.3.4",
    "@accelbyte/sdk-basic": "6.2.9",
    "@accelbyte/sdk-gdpr": "5.3.7",
    "@accelbyte/sdk-iam": "6.3.7",
    "@accelbyte/sdk-legal": "6.3.7",
    "@accelbyte/sdk-platform": "6.3.7",
    "@phosphor-icons/react": "2.1.10",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.78.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.22"
  }
}
