# Copy to .env and fill in. Never commit .env.
# scripts/create-iam-client.sh creates the IAM client and writes this file.

# Public URL of this app, as players reach it. The IAM client's redirect URI
# must be APP_URL + /auth/callback.
APP_URL=http://localhost:5173

# AGS environment
AGS_BASE_URL=https://<your-studio>-<your-game>.prod.gamingservices.accelbyte.io
AGS_NAMESPACE=<your-game-namespace>

# IAM client ID. Create a Public client (no secret) with player-level
# permissions only, never admin permissions.
AGS_CLIENT_ID=
